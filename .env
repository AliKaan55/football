# Bu proje artık yapay zeka (Gemini/AI) kullanmıyor — futbolcu doğrulama,
# yerel Transfermarkt veri setinden (data/players-dataset.json) çalışır.
# Bu yüzden API anahtarına ihtiyaç yoktur.

# PORT: Sunucunun çalışacağı port (opsiyonel, varsayılan 3000).
PORT=3000

# ADMIN_PASSWORD: Admin paneline (kulüp/oyuncu yönetimi) giriş şifresi.
# Yerelde denemek için bir şifre yazın; canlı sitede Vercel > Settings >
# Environment Variables bölümünden ekleyin. Şifreyi bu dosyaya gerçek
# değerle yazıp GitHub'a göndermeyin.
# ADMIN_PASSWORD=

# Veritabanı (canlı sitede): Vercel'de Storage > Upstash Redis bağlayınca
# KV_REST_API_URL ve KV_REST_API_TOKEN otomatik eklenir. Yerelde bu ayarlar
# yoksa değişiklikler .local-store.json dosyasına kaydedilir.
